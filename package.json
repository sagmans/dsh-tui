{
  "name": "@sagmans/dsh-tui",
  "version": "0.1.0",
  "description": "Terminal (CLI TUI) surface for DeepSeek Harness: interactive dsh in a terminal, no browser required",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "tui",
    "terminal",
    "cordis"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagmans/dsh-tui.git"
  },
  "homepage": "https://github.com/sagmans/dsh-tui#readme",
  "bugs": "https://github.com/sagmans/dsh-tui/issues",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 <0.1.6",
      "dshReleases": {
        "0.1.5-rc.1": "compatible"
      },
      "profiles": [
        "tui"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:release": "python3 -m unittest discover -s tests/release -p 'test_*.py'",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "drive": "node tools/pty-drive.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.1",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.5-rc.1",
    "@deepseek-ai/dsh-cordis-host-runner": "0.1.5-rc.1",
    "@earendil-works/pi-tui": "0.85.1",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.1",
    "@types/node": "^24.0.0",
    "node-pty": "1.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
