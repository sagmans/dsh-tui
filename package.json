{
  "name": "@sagmans/dsh-tui",
  "version": "0.1.0",
  "description": "OpenTUI profile bundle for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=26.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagmans/dsh-tui.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./service/client": {
      "types": "./lib/services/client.d.ts",
      "default": "./lib/services/client.js"
    },
    "./feature/shell": {
      "types": "./lib/features/shell/index.d.ts",
      "default": "./lib/features/shell/index.js"
    },
    "./feature/sessions": {
      "types": "./lib/features/sessions/index.d.ts",
      "default": "./lib/features/sessions/index.js"
    },
    "./feature/conversation": {
      "types": "./lib/features/conversation/index.d.ts",
      "default": "./lib/features/conversation/index.js"
    },
    "./feature/tools": {
      "types": "./lib/features/tools/index.d.ts",
      "default": "./lib/features/tools/index.js"
    },
    "./feature/interactions": {
      "types": "./lib/features/interactions/index.d.ts",
      "default": "./lib/features/interactions/index.js"
    },
    "./feature/operations": {
      "types": "./lib/features/operations/index.d.ts",
      "default": "./lib/features/operations/index.js"
    },
    "./feature/settings": {
      "types": "./lib/features/settings/index.d.ts",
      "default": "./lib/features/settings/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts/index.d.ts",
      "default": "./lib/contracts/index.js"
    },
    "./testing": {
      "types": "./lib/testing/index.d.ts",
      "default": "./lib/testing/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "test": "vitest run",
    "check": "corepack pnpm run typecheck && corepack pnpm run lint && corepack pnpm run test && corepack pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.0-rc.6",
    "@deepseek-ai/dsh-cordis-host-runner": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-message-feedback": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection-cache": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-stats": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-json": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.6",
    "@opentui/core": "0.5.1",
    "@opentui/keymap": "0.5.1",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.2",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
