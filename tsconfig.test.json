{
  // Specs share the production type contract without producing package artifacts.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Sources and specs belong to one check, outside the production-only src root.
    "rootDir": ".",
    // Mirror Vitest's source alias so checking and execution resolve the same modules;
    // parent-relative traversal is unreliable under that runner.
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    // This no-emit check can accept TypeScript source extensions without applying
    // the production rewrite intended for executable JS artifacts.
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests"
  ]
}
