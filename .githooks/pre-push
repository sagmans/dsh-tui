#!/bin/sh
# Repository routing must preserve the existing global policy without maintaining a second copy.
set -eu
readonly HOOK_FAILURE_STATUS=1
readonly GLOBAL_HOOK_ERROR='Required global pre-push hook is unavailable or recursive.'
global_hooks=$(git config --global --includes --path --get core.hooksPath)
global_hook="$global_hooks/pre-push"
if [ ! -x "$global_hook" ] || [ "$global_hook" -ef "$0" ]; then
  printf '%s\n' "$GLOBAL_HOOK_ERROR" >&2
  exit "$HOOK_FAILURE_STATUS"
fi
"$global_hook" "$@"
# The inherited policy consumes Git ref input; local graph checks need only this checkout.
root=$(git rev-parse --show-toplevel)
cd "$root"
exec pnpm run check:local
