#!/bin/sh
# Type-checks for unused locals and parameters when staged TypeScript changed.
# The staged content of the whole project is checked (copied from the index
# into a temporary tree), never the working tree.
set -eu

# Shared helpers (staged_git, pushed_shas, at_sha, darwin_only) from the dotf
# dispatcher, which also scrubs git's repository-local variables first.
# shellcheck source=/dev/null
. "${HOOK_HELPERS:?HOOK_HELPERS is not set: run this hook through the dotf git hooks dispatcher}"
# Repository helpers, loaded relative to this script (the reviewed copy).
# shellcheck source=../_lib/staged.sh
. "$(dirname -- "$0")/../_lib/staged.sh"

if staged_git diff --cached --quiet --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mts' '*.cts'; then
	exit 0
fi
staged_tree
cd "$st_tree"
./node_modules/.bin/tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters
