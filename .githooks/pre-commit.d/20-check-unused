#!/bin/sh
# Type-checks for unused locals and parameters when staged TypeScript changed.
# The whole project is checked (working tree), which is accepted for speed.
set -eu

# Helpers (staged_git, pushed_shas, at_sha, darwin_only) from .githooks/lib.
# shellcheck source=/dev/null
. "${HOOK_HELPERS:?run from .githooks (scripts/setup-hooks)}"

if staged_git diff --cached --quiet --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mts' '*.cts'; then
	exit 0
fi
pnpm run check:unused
