#!/bin/sh
# Installs the packed artefact in a clean container the way a consumer would.
# It needs Docker. Without a running Docker daemon the push fails: the hook has
# no skip switch, so the consumer install is proven on every pushed commit.
set -eu
DSH_TELEMETRY_DISABLED=1
export DSH_TELEMETRY_DISABLED

# Limits for run_step. Each one catches a hang, not a slow run. `docker info`
# only asks the local daemon; the smoke pulls an image and installs packages.
DOCKER_INFO_TIMEOUT_SECONDS=30
INSTALL_TIMEOUT_SECONDS=300
SMOKE_TIMEOUT_SECONDS=600

# Its output stays quiet here and not on the run_step line, so the timeout text
# of run_step still reaches the reader.
docker_info_quiet() {
	docker info >/dev/null 2>&1
}

checks() {
	if ! command -v docker >/dev/null 2>&1 ||
		! run_step 'docker info' "$DOCKER_INFO_TIMEOUT_SECONDS" docker_info_quiet; then
		echo "pre-push: Docker is unavailable, so the consumer install smoke cannot run." >&2
		echo "Install Docker and start its daemon, then push again." >&2
		return 1
	fi
	run_step 'install smoke' "$SMOKE_TIMEOUT_SECONDS" node tools/install-smoke.mjs || return 1
}

# Helpers (staged_git, pushed_shas, at_sha, darwin_only) from .githooks/lib.
# shellcheck source=/dev/null
. "${HOOK_HELPERS:?run from .githooks (scripts/setup-hooks)}"

top=$(git rev-parse --show-toplevel)
# A temporary worktree has no dependencies: install them from that commit's
# lockfile (never resolved; npm skips lifecycle scripts, pnpm runs only the
# builds allowed in pnpm-workspace.yaml). In place, the clone's install is used.
install_deps() {
	[ "$(pwd -P)" != "$(CDPATH='' cd -- "$top" && pwd -P)" ] || return 0
	if [ -f pnpm-lock.yaml ]; then
		run_step 'pnpm install' "$INSTALL_TIMEOUT_SECONDS" pnpm install --frozen-lockfile >/dev/null || return 1
	elif [ -f package-lock.json ]; then
		run_step 'npm ci' "$INSTALL_TIMEOUT_SECONDS" npm ci --ignore-scripts --no-audit --no-fund >/dev/null || return 1
	fi
}

# at_sha runs this with set -e off, so every step returns on failure.
run_at() {
	install_deps || return 1
	checks || return 1
}

# Each pushed commit is tested as pushed: in place when it is a clean HEAD,
# otherwise in a temporary worktree. A for loop, never `| while`, so a failure
# blocks the push.
shas=$(pushed_shas <"$HOOK_STDIN_FILE") || exit 1
for pp_commit in $shas; do
	echo "pre-push: $(basename -- "$0"): checking $pp_commit" >&2
	if ! at_sha "$pp_commit" run_at; then
		echo "pre-push: $(basename -- "$0"): checks failed for $pp_commit" >&2
		exit 1
	fi
done
