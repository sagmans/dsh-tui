#!/bin/sh
# Runs the gates hosted CI ran on every push (signatures, typecheck, golden
# frames, pack smoke, terminal behavior, harness matrix) on each pushed commit.
set -eu
DSH_TELEMETRY_DISABLED=1
export DSH_TELEMETRY_DISABLED

checks() {
	npm audit signatures || return 1
	pnpm run check:local || return 1
	pnpm typecheck || return 1
	pnpm test:golden || return 1
	node tools/pack-smoke.mjs || return 1
	pnpm test:terminal || return 1
	node tools/harness-matrix.mjs || return 1
}

# Shared helpers (staged_git, pushed_shas, at_sha, darwin_only) from the dotf
# dispatcher, which also scrubs git's repository-local variables first.
# shellcheck source=/dev/null
. "${HOOK_HELPERS:?HOOK_HELPERS is not set: run this hook through the dotf git hooks dispatcher}"
# Repository helpers, loaded relative to this script (the reviewed copy).
# shellcheck source=../_lib/prepush.sh
. "$(dirname -- "$0")/../_lib/prepush.sh"
run_pushed
