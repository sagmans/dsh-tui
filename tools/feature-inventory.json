  "commands": [
    {
      "command": "/help",
      "description": "list registered and local commands",
      "feature": "commands"
    },
    {
      "command": "/status",
      "description": "show the session, model, permissions, and context",
      "feature": "commands"
    },
    {
      "command": "/model",
      "description": "open the model picker (type to filter); /model <provider>/<model> switches directly",
      "feature": "model-directory"
    },
    {
      "command": "/preset",
      "description": "choose the agent preset (mode) this session runs",
      "feature": "modes"
    },
    {
      "command": "/todo",
      "description": "show tasks or distinguish never-written, empty and turn-cleared todo state",
      "feature": "commands"
    },
    {
      "command": "/theme",
      "description": "open the theme picker, the screen previewing each row; /theme <name> applies one; /theme tokens lists the elements",
      "feature": "appearance"
    },
    {
      "command": "/keys",
      "description": "open the key map and filter it by typing; /keys <layer> narrows it",
      "feature": "keymap"
    },
    {
      "command": "/jobs",
      "description": "list background jobs, read one, or kill one; read/kill accept exactly one job id",
      "feature": "jobs"
    },
    {
      "command": "/subagents",
      "description": "list delegations; /subagents open <id|last> reads one, /subagents kill <id> stops one",
      "feature": "subagents"
    },
    {
      "command": "/fork",
      "description": "branch this conversation and continue in the branch",
      "feature": "fork-undo-redo"
    },
    {
      "command": "/new",
      "description": "start a fresh session without leaving the terminal",
      "feature": "sessions"
    },
    {
      "command": "/reload",
      "description": "recompose this session from its preset and replay the transcript",
      "feature": "sessions"
    },
    {
      "command": "/undo",
      "description": "hide the newest prompt and its turn, and put that prompt back in the bar",
      "feature": "fork-undo-redo"
    },
    {
      "command": "/redo",
      "description": "step forward again after an undo",
      "feature": "fork-undo-redo"
    },
    {
      "command": "/rename",
      "description": "give this session a title the picker will show",
      "feature": "sessions"
    },
    {
      "command": "/export",
      "description": "write the visible transcript to a markdown file",
      "feature": "export"
    },
    {
      "command": "/copy",
      "description": "copy the last answer to the clipboard through the terminal",
      "feature": "copy"
    },
    {
      "command": "/history",
      "description": "show where prompt history is kept; /history clear forgets every prompt",
      "feature": "history"
    },
    {
      "command": "/clear",
      "description": "clear the visible transcript",
      "feature": "commands"
    },
    {
      "command": "/resume",
      "description": "open another stored session",
      "feature": "sessions"
    },
    {
      "command": "/quit",
      "description": "leave and print the resume command",
      "feature": "commands"
    },
    {
      "command": "/exit",
      "description": "leave and print the resume command",
      "feature": "commands"
    },
    {
      "command": "/stash",
      "description": "store the draft typed after it; ctrl+x then s parks the editor",
      "feature": "stash"
    },
    {
      "command": "/stash-pop",
      "description": "put a stashed draft (newest by default) into the editor and remove it",
      "feature": "stash"
    },
    {
      "command": "/stash-apply",
      "description": "put a stashed draft (newest by default) into the editor and keep it",
      "feature": "stash"
    },
    {
      "command": "/stash-list",
      "description": "open the current stash bank; enter pops one",
      "feature": "stash"
    },
    {
      "command": "/stash-drop",
      "description": "delete a stashed draft (newest by default) without using it",
      "feature": "stash"
    },
    {
      "command": "/stash-clear",
      "description": "delete every draft in the current stash bank after a confirmation",
      "feature": "stash"
    }
  ],
